* {
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}
body {
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: #efefef;
}
header {
  padding: 2rem 4rem;
  border-bottom: 2px solid #29213f;
}
header ul {
  list-style: none;
}
header a {
  text-decoration: none;
  color: inherit;
  font-style: normal;
}
header a:hover {
  color: hotpink;
}
header img {
  display: block;
  aspect-ratio: 1;
  border-radius: 50%;
  object-fit: cover;
  filter: grayscale(100%);
  margin: 1rem auto;
}
h1 {
  color: peru;
  text-align: center;
  text-decoration: underline;
}
main {
  margin: 2rem 4rem;
}
section {
    margin-bottom: 3rem;
}
p {
  max-width: 80ch;
}
section li h3, section li p {
  font-size: 0.8rem;
  letter-spacing: 0.5px;
}
section li {
  margin: 0.5rem;
}